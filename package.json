{
  "name": "moggin",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "plugins:bundle": "tsup modules/expo-wakatime-glance-widgets/plugins/index.ts --format cjs --out-dir modules/expo-wakatime-glance-widgets/plugins",
    "module:bundle": "tsup modules/expo-material-dynamic-colors/src/index.ts --format cjs --out-dir modules/expo-material-dynamic-colors/src/",
    "reset-project": "node ./scripts/reset-project.js",
    "remove-js-files": "tsx scripts/remove-js.ts modules/expo-wakatime-glance-widgets/plugins",
    "build:android": "expo run:android",
    "build-dev:local": "eas build --platform android --profile development --local",
    "build-preview:local": "eas build --platform android --profile preview:local --local",
    "build-preview:eas": "eas build --platform android --profile preview:eas --local",
    "build:production": "eas build --platform android --profile production",

    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "dependencies": {
