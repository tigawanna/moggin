{
  "name": "moggin",
  "main": "./src/index",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "bundle-pluginn:widgets": "tsup modules/expo-wakatime-glance-widgets/plugins/index.ts --format cjs --out-dir modules/expo-wakatime-glance-widgets/plugins",
    "module:bundle": "tsup modules/expo-material-dynamic-colors/src/index.ts --format cjs --out-dir modules/expo-material-dynamic-colors/src/",
    "reset-project": "node ./scripts/reset-project.js",
    "remove-js-files": "tsx scripts/remove-js.ts modules/expo-wakatime-glance-widgets/plugins",
    "prebuild": "npx expo prebuild --platform android  --clean --no-install",
    "build:android": "npm run prebuild && expo run:android",
    "build-dev:local": "npm run prebuild && eas build --platform android --profile development --local",
    "build-preview:local": "npm run prebuild  && eas build --platform android --profile preview:local --local",
    "build-preview:eas": "npm run prebuild && eas build --platform android --profile preview:eas",
    "build:production": "npm run prebuild && eas build --platform android --profile production",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/ui": "0.2.0-beta.7",
    "@expo/vector-icons": "^15.0.2",
    "@material/material-color-utilities": "^0.3.0",
    "@react-native-firebase/app": "^23.4.1",
    "@react-native-firebase/crashlytics": "^23.4.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@shopify/react-native-skia": "2.2.12",
    "@tanstack/query-async-storage-persister": "^5.90.7",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-query-persist-client": "^5.90.7",
    "@types/node": "^24.7.2",
    "@types/xml2js": "^0.4.14",
    "babel-plugin-module-resolver": "^5.0.2",
    "colors": "^1.4.0",
    "deepmerge": "^4.3.1",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "expo": "~54.0.13",
    "expo-blur": "~15.0.7",
    "expo-build-properties": "~1.0.9",
    "expo-constants": "~18.0.9",
    "expo-dev-client": "~6.0.15",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.9",
    "expo-linking": "~8.0.8",
    "expo-network": "~8.0.7",
    "expo-router": "~6.0.11",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-updates": "~29.0.12",
    "expo-web-browser": "~15.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-mmkv": "^3.3.3",
    "react-native-paper": "^5.14.5",
    "react-native-random-uuid": "^0.1.4",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "ts-node": "^10.9.2",
    "victory-native": "^41.20.1",
    "xml2js": "^0.6.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@testing-library/react-native": "^13.3.3",
    "@types/color": "^4.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-testing-library": "^7.13.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  },
  "private": true
}
